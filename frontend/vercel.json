{
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "functions": {
    "api/**/*.py": {
      "runtime": "vercel-python@3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
